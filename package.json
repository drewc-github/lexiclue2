{
  "name": "lexiclue2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "generate:words": "node scripts/generateWords.mjs",
    "review:words": "node scripts/generateWords.mjs --reprocess",
    "repair:words": "node scripts/generateWords.mjs --repair-missing",
    "repair:choices": "node scripts/generateWords.mjs --similar",
    "normalize:choices": "node scripts/normalizeChoices.mjs",
    "schedule:games": "node scripts/generateSchedule.mjs",
    "batch:words": "node scripts/batchReviewWords.mjs",
    "backfill:words": "node scripts/generateWords.mjs --outdated",
    "validate:content": "node scripts/validateContent.mjs"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
